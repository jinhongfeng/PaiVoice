# Never commit real credentials or private endpoints.
# Jester 魔改版环境变量（电话项目，2026-09-01）——真 Key 只放服务器部署环境。

# --- 通话服务 ---
PAIVOICE_HOST=0.0.0.0
PAIVOICE_PORT=8780
PAIVOICE_TOKEN=change-me            # 浏览器拨号令牌
PAIVOICE_MAX_TURN_SECONDS=60

# --- 耳朵 ASR ---
PAIVOICE_ASR_PROVIDER=siliconflow   # mock | groq | siliconflow
PAIVOICE_ASR_API_KEY=
PAIVOICE_SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# --- 嘴 TTS ---
PAIVOICE_TTS_PROVIDER=elevenlabs    # mock | elevenlabs | minimax(桩)
PAIVOICE_TTS_API_KEY=
PAIVOICE_ELEVEN_MODEL=eleven_v3          # 或 eleven_multilingual_v2
PAIVOICE_ELEVEN_STABILITY=0.5        # v3专属: 0.0 Creative / 0.5 Natural / 1.0 Robust
PAIVOICE_ELEVEN_VOICE_ID=

PAIVOICE_SB_URL=https://your-project.supabase.co
PAIVOICE_SB_KEY=your-anon-or-publishable-key

# --- 大脑：网关语音快车道（OpenAI 兼容 + SSE）---
PAIVOICE_GATEWAY_URL=https://your-gateway.example/v1/chat/completions
PAIVOICE_GATEWAY_TOKEN=
PAIVOICE_ARCHIVE_URL=https://your-gateway.example/v1/voice/archive

# --- 人设定制（可选）：称呼 / 聊天语气 / 聊天风格 ---
# 存 config/persona.json（设置面板「人设」热改，重启保留）；此项仅改存档路径
# PAIVOICE_PERSONA_FILE=config/persona.json

# --- 五轨记忆（默认开启，SQLite，零依赖）---
# 直连 Ollama 等普通 OpenAI 兼容端点时网关不负责记忆，没有它模型每轮失忆。
# 对话原文落本地 SQLite（data/paivoice.db，或 PAIVOICE_DATA_DIR 指定目录），跨通话/跨重启；
# 后台空闲时自动用大脑模型总结出用户档案/长期记忆/项目记忆/今日日志，下一轮自动注入。
# 备份 = 拷 paivoice.db；让她彻底失忆 = 删该文件。Electron 打包时由主进程把
# PAIVOICE_DATA_DIR 指向 app.getPath('userData')。
PAIVOICE_DATA_DIR=
PAIVOICE_GIT_ROOT=              # 项目 git 仓库根（L2 项目记忆按分支分桶）；空=自动向上找，找不到回退 default
PAIVOICE_MEMORY_TURNS=50        # 每轮回放的最近对话条数（user+assistant 合计）
PAIVOICE_MEMORY_INTERVAL=600    # 后台进化检查间隔（秒）
PAIVOICE_MEMORY_COOLDOWN=300    # 距上次总结的最小间隔（秒），防频繁烧 token
PAIVOICE_MEMORY_MIN_TURNS=5     # 新轮次 ≥ N 才值得跑一次总结
PAIVOICE_MEMORY_SUMMARY_MODEL=  # 总结专用模型（如 qwen2.5:7b）；空 = 用当前 LLM_MODEL
# 记忆块各段字数预算（闲聊 max_tokens=384，记忆块必须小）
PAIVOICE_MEM_BUDGET_TODAY=200
PAIVOICE_MEM_BUDGET_PROFILE=600
PAIVOICE_MEM_BUDGET_LONGTERM=800
PAIVOICE_MEM_BUDGET_PROJECT=600

# --- 旧版 MySQL 记忆（已废弃，不再使用）---
# v2 起记忆改 SQLite，pymysql 依赖已移除；以下变量仅保留兼容，置空即停用。
PAIVOICE_MYSQL_HOST=
PAIVOICE_MYSQL_PORT=3306
PAIVOICE_MYSQL_USER=root
PAIVOICE_MYSQL_PASSWORD=
PAIVOICE_MYSQL_DB=paivoice

# --- 兼容：原 Adapter / Groq 路线（可选）---
PAIVOICE_ADAPTER_URL=
PAIVOICE_ADAPTER_TOKEN=
# GROQ_API_KEY=
