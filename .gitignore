# --- 密钥/环境（绝不提交）---
.env
.env.*
!.env.example

# --- 运行时配置（个人设定，含昵称/模型档案；模板见 *.example）---
config/persona.json
config/api_profiles.json
config/*.tmp

# --- 依赖 / 虚拟环境 ---
node_modules/
node_modules$name/
.venv/
wheels/

# --- Python 产物 ---
__pycache__/
*.py[cod]
.pytest_cache/

# --- 运行时产物（日志 / 数据 / 录音）---
*.log
logs/
data/
recordings/
transcripts/
memories/
.pet_upgrade_tmp/

# --- 大体积下载产物（可用 tools/models_download.py 重新获取）---
models/

# --- 音频试听样本（tools/make_voice_samples.py 可再生）---
试听/

# --- 系统杂项 ---
.DS_Store
Thumbs.db

# --- Electron 打包产物 ---
dist/
build/
release/

# --- 本机构建工具产物 ---
*.exe.spec

# --- 会话辅助目录 ---
.zcode/
